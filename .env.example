# --- AI pipeline ---
# The main video analysis flow prefers OpenRouter when this is set.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model override for uploaded video analysis.
# Must be an OpenRouter model whose input modalities include video.
# Default: google/gemini-2.5-flash
# OPENROUTER_DEFAULT_VIDEO_MODEL=google/gemini-2.5-flash


# Optional generic OpenRouter override used by the lab and as a secondary
# fallback for the main video pipeline when OPENROUTER_VIDEO_MODEL is unset.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional public site URL sent to OpenRouter rankings/analytics headers.
# OPENROUTER_SITE_URL=http://localhost:3000

# Fallback provider when OPENROUTER_API_KEY is not set.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_SAM=false

# Optional Gemini model override for the lab's fallback path.
# GEMINI_MODEL=gemini-flash-latest

# --- Council of Agents (backend/council) ---
# Multi-model debate layer. All calls go through OPENROUTER_API_KEY above.

# Master switch. When false, runCouncil() delegates to the single-model
# baseline arm (runSingleModel) — the control arm of the A/B.
# COUNCIL_ENABLED=true

# Panel seat models. Each seat is a DIFFERENT model wearing a DIFFERENT lens;
# pointing two seats at the same slug destroys the diversity the metrics assume.
# Seat 1 = literalist, seat 2 = prosecutor, seat 3 = defender.
# COUNCIL_SEAT_1_MODEL=google/gemini-2.5-flash
# COUNCIL_SEAT_2_MODEL=openai/gpt-4o-mini
# COUNCIL_SEAT_3_MODEL=anthropic/claude-haiku-4.5

# Optional seats 4 and 5, used only by extendedSeats() (not the default roster).
# Seat 4 = skeptic, seat 5 = contextualist.
# COUNCIL_SEAT_4_MODEL=mistralai/mistral-small-3.2-24b-instruct
# COUNCIL_SEAT_5_MODEL=meta-llama/llama-3.3-70b-instruct

# Chair model. Stronger and pricier; only invoked when the council stays split.
# COUNCIL_CHAIR_MODEL=anthropic/claude-opus-4.5

# Tried when a seat's own model returns a model-specific error (bad slug, no
# credits, per-model rate cap).
# COUNCIL_FALLBACK_MODEL=openai/gpt-4o-mini

# Escalation gates. Debate is skipped only when BOTH pass.
# 0.75 sits between 2/3 and 1, so a 3-seat panel must be unanimous.
# COUNCIL_CONSENSUS_THRESHOLD=0.75
# 0.65 is the MEDIUM confidence-band midpoint: three hedging seats still debate.
# COUNCIL_MIN_PROBABILITY=0.65

# Minimum seats that must return before a result is usable; below this the
# council throws CouncilQuorumError rather than reporting a meaningless score.
# COUNCIL_QUORUM=2

# Hard wall-clock ceiling for the whole council, enforced via AbortController.
# COUNCIL_TIMEOUT_MS=45000

# Dedicated wall-clock budget for the chair, on its own deadline. The chair runs
# a slower model and is only reached on contested cases; sharing one budget with
# the panel and debate rounds starved it exactly when it mattered.
# COUNCIL_CHAIR_TIMEOUT_MS=30000


# ---------------------------------------------------------------------------
# Analysis graph (backend/graph/**)
#
# The graph wraps the council with the two things the council could not check
# itself: a second observer whose disagreements with the first become explicit
# contested facts, and an evidence auditor that grades the finished answer.
# Everything here is optional; the defaults are what production runs.
# ---------------------------------------------------------------------------

# Master switch. When false the graph runs ONE observer and skips the auditor,
# which is the pre-graph behaviour plus the artifact trail.
# GRAPH_ENABLED=true

# Vision model for observer A, which reads the ORIGINAL clip with no CV hints.
# Defaults to OPENROUTER_VIDEO_MODEL, i.e. whatever the old pipeline used.
# GRAPH_OBSERVER_A_MODEL=google/gemini-2.5-flash

# Vision model for observer B, which reads the CV-annotated render, the skeleton
# overlay and the contact keyframes. Defaults to the SAME slug as observer A:
# few models accept video, so the diversity that actually exists at this stage
# is diversity of EVIDENCE, not of weights. Point this at a second video-capable
# model when you have one and the fan-out gets strictly stronger.
# GRAPH_OBSERVER_B_MODEL=google/gemini-2.5-flash

# Merges the two accounts and names what they disagree about. Text-only, cheap.
# GRAPH_RECONCILER_MODEL=google/gemini-2.5-flash

# The evidence auditor. MUST NOT be a model that produced the answer it grades —
# if you change the seat roster or the chair, change this too, or you have
# reintroduced a self-grading node wearing a different hat.
# GRAPH_AUDITOR_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Wall-clock for the whole observation stage (both observers + the reconciler).
# GRAPH_OBSERVE_TIMEOUT_MS=60000

# The auditor runs on its own deadline, for the same reason the chair does.
# GRAPH_AUDIT_TIMEOUT_MS=20000

# Retrieval shortlist size. Matches backend/ai/pipeline.ts.
# GRAPH_K=5

# Per-run artifact directory: one subdirectory per analysis, plus review-queue/.
# Writes are best-effort and never fail a request, so a read-only filesystem
# degrades to a console warning rather than a 500.
# GRAPH_RUNS_DIR=backend/runs
# Set to 0/false/off to disable artifact writing entirely.
# GRAPH_ARTIFACTS=true
