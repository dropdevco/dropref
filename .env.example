# --- AI pipeline ---
# The main video analysis flow prefers OpenRouter when this is set.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model override for uploaded video analysis.
# Must be an OpenRouter model whose input modalities include video.
# Default: google/gemini-2.5-flash
# OPENROUTER_DEFAULT_VIDEO_MODEL=google/gemini-2.5-flash


# Optional generic OpenRouter override used by the lab and as a secondary
# fallback for the main video pipeline when OPENROUTER_VIDEO_MODEL is unset.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional public site URL sent to OpenRouter rankings/analytics headers.
# OPENROUTER_SITE_URL=http://localhost:3000

# Fallback provider when OPENROUTER_API_KEY is not set.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_SAM=false

# Optional Gemini model override for the lab's fallback path.
# GEMINI_MODEL=gemini-flash-latest
