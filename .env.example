# --- AI pipeline (Dev B) ---
# Google Gemini API key — used by the app's real analyze() pipeline.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Rulebook Lab adjudication (Dev A dev tool, /lab) ---
# The lab prefers OpenRouter when this is set (OpenAI-compatible, called via
# fetch — no extra npm dep). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Feature Flags
ENABLE_CV_SERVICE=true

# Optional model override (default: openai/gpt-4o-mini). Any OpenRouter model id.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional Gemini model override for the lab's fallback path (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest
